executable(
    meson.project_name(),
    'Application.vala',
    'PlayXVsink.vala',
    'TransparentHeader.vala',
    'WindowPage.vala',
    'PeakBar.vala',
    'VideoFrame.vala',
    'SubtitleEntry.vala',
    'SubtitleOverlay.vala',
    'FrameTexture.vala',
    'ValaExtend.vala',
    'SubtitleSpan.vala',
    'VideoWithCrop.vala',
    'CropView.vala',
    'PlayXaudio.vala',
    'PlayXAsink.vala',
    'NoiseCanceller.vala',
    'Limiter.vala',
    'HiFiEqualizer.vala',
    'BiquadState.vala',
    'DolbySurround.vala',
    'AllPassShifter.vala',
    'PlayXEnum.vala',
    'OsdIconPaintable.vala',
    'Helper.vala',
    'DmaBufUpload.vala',
    'CpuVideoPassthrough.vala',
    'PlayXSettings.vala',
    'MediaInfo.vala',
    'PlayXSsink.vala',
    'OsdOverlayWidget.vala',
    'LabelOutline.vala',
    'IconOutline.vala',

    vala_args : vala_args,
    dependencies: [
        dependency ('glib-2.0'),
        dependency ('gtk4'),
        dependency ('libsoup-3.0'),
        dependency ('gee-0.8'),
        dependency ('json-glib-1.0'),
        dependency ('gdk-pixbuf-2.0'),
        dependency ('gobject-2.0'),
        dependency ('gstreamer-1.0'),
        dependency ('gstreamer-base-1.0'),
        dependency ('gstreamer-pbutils-1.0'),
        dependency ('gstreamer-tag-1.0'),
        dependency ('gstreamer-video-1.0'),
        dependency ('gstreamer-allocators-1.0'),
        dependency ('gstreamer-audio-1.0'),
        dependency ('gstreamer-app-1.0'),
        dependency ('libpulse'),
        dependency ('libpulse-simple'),
        dependency ('alsa'),
        dependency ('libadwaita-1'),

        meson.get_compiler ('vala').find_library ('posix'),
        meson.get_compiler ('c').find_library ('m', required : false),
    ],
    cpp_args: ['-std=c++17'],
    link_args: ['-lm', '-lstdc++'],
    install : true
)